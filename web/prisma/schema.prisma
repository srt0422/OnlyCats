generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  votes     Vote[]
}

model CatImage {
  id          String   @id @default(cuid())
  imageUrl    String
  generatedAt DateTime @default(now())
  votes       Vote[]
  isWinner    Boolean  @default(false)
}

model Vote {
  id         String   @id @default(cuid())
  userId     String
  catImageId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  catImage   CatImage @relation(fields: [catImageId], references: [id])

  @@unique([userId, catImageId])
} 